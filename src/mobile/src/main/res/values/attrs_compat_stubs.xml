<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MultiWaveHeader">
        <attr name="mwhStartColor" format="color" />
        <attr name="mwhCloseColor" format="color" />
        <attr name="mwhProgress" format="float" />
        <attr name="mwhVelocity" format="float" />
        <attr name="mwhWaves" format="string" />
        <attr name="mwhIsRunning" format="boolean" />
    </declare-styleable>

    <declare-styleable name="AVLoadingIndicatorView">
        <attr name="indicatorName" format="string" />
        <attr name="indicatorColor" format="color" />
        <attr name="minWidth" format="dimension" />
        <attr name="maxWidth" format="dimension" />
        <attr name="minHeight" format="dimension" />
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>

    <declare-styleable name="CircleProgressView">
        <attr name="cpv_autoTextSize" format="boolean" />
        <attr name="cpv_barColor" format="color" />
        <attr name="cpv_barWidth" format="dimension" />
        <attr name="cpv_fillColor" format="color" />
        <attr name="cpv_innerContourColor" format="color" />
        <attr name="cpv_innerContourSize" format="dimension" />
        <attr name="cpv_maxValue" format="float" />
        <attr name="cpv_outerContourColor" format="color" />
        <attr name="cpv_outerContourSize" format="dimension" />
        <attr name="cpv_rimColor" format="color" />
        <attr name="cpv_rimWidth" format="dimension" />
        <attr name="cpv_seekMode" format="boolean" />
        <attr name="cpv_showUnit" format="boolean" />
        <attr name="cpv_spinColor" format="color" />
        <attr name="cpv_text" format="string" />
        <attr name="cpv_textColor" format="color" />
        <attr name="cpv_textMode" format="string" />
        <attr name="cpv_textScale" format="float" />
        <attr name="cpv_unit" format="string" />
        <attr name="cpv_unitColor" format="color" />
        <attr name="cpv_unitPosition" format="string" />
        <attr name="cpv_unitScale" format="float" />
        <attr name="cpv_value" format="float" />
    </declare-styleable>

    <declare-styleable name="RangeBar">
        <attr name="mrb_pinColor" format="color" />
        <attr name="mrb_pinRadius" format="dimension" />
        <attr name="mrb_pinTextColor" format="color" />
        <attr name="mrb_selectorBoundaryColor" format="color" />
        <attr name="mrb_selectorSize" format="dimension" />
        <attr name="mrb_pinMaxFont" format="dimension" />
        <attr name="mrb_tickColor" format="color" />
        <attr name="mrb_rangeBar" format="boolean" />
        <attr name="mrb_selectorBoundarySize" format="dimension" />
        <attr name="mrb_tickEnd" format="float" />
        <attr name="mrb_selectorColor" format="color" />
        <attr name="mrb_pinPadding" format="dimension" />
        <attr name="mrb_tickInterval" format="float" />
        <attr name="mrb_temporaryPins" format="boolean" />
        <attr name="mrb_tickStart" format="float" />
        <attr name="mrb_rangeBarColor" format="color" />
        <attr name="mrb_connectingLineColor" format="color" />
        <attr name="mrb_connectingLineWeight" format="dimension" />
        <attr name="mrb_barWeight" format="dimension" />
        <attr name="mrb_barColor" format="color" />
    </declare-styleable>

    <style name="AVLoadingIndicatorView" />
    <style name="AVLoadingIndicatorView.Small" parent="AVLoadingIndicatorView" />
    <style name="AVLoadingIndicatorView.Large" parent="AVLoadingIndicatorView" />
</resources>
