<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="0dp"
    android:fitsSystemWindows="false"
    app:elevation="0dp"
    >

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/lomo"
            android:scaleType="centerCrop"
            />

        <com.scwang.wave.MultiWaveHeader
            android:id="@+id/wave"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_alignParentTop="true"
            android:alpha="0.3"
            android:scaleY="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:mwhCloseColor="@color/transparent"
            app:mwhIsRunning="false"
            app:mwhProgress="1"
            app:mwhStartColor="@color/translucent_accent"
            app:mwhVelocity="1"
            app:mwhWaves="PairWave"/>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_alignParentBottom="true"
            android:alpha="0.15"
            android:src="@drawable/playback_ui_wave"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/top_layout"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/gradient_top_down"
        android:elevation="0dp"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/bottom_layout"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@drawable/gradient_bottom_up"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/page_tabs"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/page_host"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/metadata_layout">

        <TextView
            android:id="@+id/tab_vfx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="VFX"
            android:textColor="@color/primary_text"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tab_cover"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cover"
            android:textColor="@color/primary_text"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tab_lyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Lyrics"
            android:textColor="@color/primary_text"
            android:textSize="13sp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/page_host"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/controls_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/page_tabs">

        <com.ilusons.harmony.avfx.VizCanvas
            android:id="@+id/avfx_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/cover"
            android:layout_width="282dp"
            android:layout_height="282dp"
            android:layout_gravity="center"
            android:elevation="9dp"
            android:scaleType="fitXY"
            android:src="@drawable/logo"
            android:transitionName="transition_cover"/>

        <ScrollView
            android:id="@+id/lyrics_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdgeLength="36dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none"
            android:visibility="gone">

            <TextView
                android:id="@+id/lyrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="48dp"
                android:layout_marginEnd="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginTop="24dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:lineSpacingMultiplier="1.2"
                android:paddingBottom="72dp"
                android:paddingTop="72dp"
                android:shadowColor="@android:color/black"
                android:shadowDx="0.7"
                android:shadowDy="1.5"
                android:shadowRadius="1.7"
                android:textAlignment="center"
                android:textSize="16.5sp"/>
        </ScrollView>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/metadata_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        >

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="16dp"
            android:clickable="false"
            android:ellipsize="middle"
            android:focusable="false"
            android:paddingEnd="24dp"
            android:paddingStart="24dp"
            android:shadowColor="@android:color/black"
            android:shadowDx="0.7"
            android:shadowDy="1.5"
            android:shadowRadius="1.7"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/primary_text"
            android:textSize="22sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Title"
            />

        <TextView
            android:id="@+id/artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="8dp"
            android:clickable="false"
            android:ellipsize="middle"
            android:focusable="false"
            android:paddingEnd="24dp"
            android:paddingStart="24dp"
            android:shadowColor="@android:color/black"
            android:shadowDx="0.7"
            android:shadowDy="1.5"
            android:shadowRadius="1.7"
            android:singleLine="true"
            android:text=""
            android:textColor="@color/primary_text"
            android:textSize="13.5sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="Artist"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/controls_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:paddingEnd="16dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/nav_bar_filler"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/controls1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/position_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/secondary_text"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Time"
                />

            <TextView
                android:id="@+id/position_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/secondary_text"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Time"
                />

            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:paddingStart="8dp"
                android:progress="50"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@id/position_start"
                app:layout_constraintRight_toLeftOf="@id/position_end"
                app:layout_constraintTop_toTopOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/controls2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controls1">

            <ImageButton
                android:id="@+id/prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.9"
                android:background="@drawable/circle_translucent"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_music_beginning"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

            <ImageButton
                android:id="@+id/play_pause_stop"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/circle_translucent"
                android:padding="10dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_music_play"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

            <ImageButton
                android:id="@+id/next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.9"
                android:background="@drawable/circle_translucent"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_music_end"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/controls2">

            <ImageButton
                android:id="@+id/avfx"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.5"
                android:background="@drawable/rectangle_translucent"
                android:padding="3dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_magic_wand"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

            <ImageButton
                android:id="@+id/shuffle"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.5"
                android:background="@drawable/rectangle_translucent"
                android:padding="3dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_music_shuffle"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

            <ImageButton
                android:id="@+id/repeat"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.5"
                android:background="@drawable/rectangle_translucent"
                android:padding="3dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_music_repeat"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

            <ImageButton
                android:id="@+id/tune"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.5"
                android:background="@drawable/rectangle_translucent"
                android:padding="3dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_music_mixer"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

            <ImageButton
                android:id="@+id/more"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.5"
                android:background="@drawable/rectangle_translucent"
                android:padding="3dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_more_vertical"
                android:tint="@color/translucent_light"
                android:tintMode="src_in"
                />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.wang.avi.AVLoadingIndicatorView
        android:id="@+id/loading"
        style="@style/AVLoadingIndicatorView.Large"
        android:layout_width="192dp"
        android:layout_height="192dp"
        android:visibility="visible"
        app:indicatorColor="@color/icons"
        app:indicatorName="BallClipRotatePulseIndicator"
        app:layout_constraintBottom_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="parent"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_bar_filler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
